# Template for .env.local (gitignored). `npm run setup` copies it and fills in the local values.
# apps/api, apps/worker and the live tests read .env.local; nothing prints it.
# Every value here is optional unless marked REQUIRED. Lines left commented out use the default named next to them. An empty integration is skipped at startup,
# together with the models, datasets and services that depend on it, and the API logs what it skipped.
# Secrets in config are written secret://env/<name> and read from <NAME> (foundry-openai-key reads FOUNDRY_OPENAI_KEY).

# --- Environment -------------------------------------------------------------------------------
# The API refuses to start without DATABASE_URL, without ANSATTPORTEN_ISSUER (or MASKINPORTEN_ISSUER plus
# MASKINPORTEN_JWKS_URI) and without ALTINN_PDP_URL, unless GENAI_DEV_MODE=true; the worker refuses without
# DATABASE_URL. Dev mode allows in-memory storage, the mock login, which issues operator tokens, and the mock
# Altinn rights: local development only. npm run setup and npm run dev:all set it for you.
GENAI_DEV_MODE=
# production (or NODE_ENV=production): the API also refuses GENAI_DEV_MODE=true.
# GENAI_ENV=

# --- Storage -----------------------------------------------------------------------------------
# REQUIRED unless GENAI_DEV_MODE=true. Empty in dev mode: everything lives in memory and is gone on restart. Local Postgres: docker compose up -d postgres
DATABASE_URL=
# REQUIRED when DATABASE_URL is set: 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored content.
CONTENT_MASTER_KEY=
# Login that is a member of genai_runtime. Empty: queries run on DATABASE_URL with SET ROLE genai_runtime.
DATABASE_RUNTIME_URL=
# Where uploaded files and local data go. Defaults: apps/api/.data and apps/api/.data/blobs (worker: .data/blobs).
# DATA_DIR=
# BLOB_DIR=

# --- Models: your Azure AI Foundry settings ------------------------------------------------------
# Empty: no Foundry models, embeddings or the services that use them. Base URL shape:
# https://<resource>.openai.azure.com/openai/v1 and https://<resource>.services.ai.azure.com/anthropic
FOUNDRY_OPENAI_BASE_URL=
FOUNDRY_OPENAI_KEY=
FOUNDRY_CLAUDE_BASE_URL=
FOUNDRY_CLAUDE_KEY=

# --- Local test model (no secrets) -------------------------------------------------------------
# An echo model served by scripts/local-model.ts; npm run dev:all starts it when this points to 127.0.0.1:8095.
# Empty: the "Lokal testchat" service is skipped.
LOCAL_MODEL_URL=
LOCAL_MODEL_KEY=

# --- Search and reranking: your own settings -----------------------------------------------------
# The Typesense headless-rag uses: https://<host>:<port>. The key may only be used to search, never to write.
# Empty: the Kudos and public-docs datasets, and the services that search them, are skipped.
TYPESENSE_URL=
TYPESENSE_KEY=
# ColBERT reranker. Empty: the colbert reranker, and services that require it, are skipped.
COLBERT_API_URL=
COLBERT_API_KEY=

# --- Documents ---------------------------------------------------------------------------------
# local (default), marker or none. marker sends PDFs to MARKER_URL and REQUIRES it.
# DOCUMENT_CONVERTER=
MARKER_URL=
MARKER_API_KEY=
# Marker retries as a JSON list of ms, such as [1000,5000], and timeout in ms.
# MARKER_RETRY_DELAYS_MS=
# MARKER_TIMEOUT_MS=
# Root folder that folder ingestion sources may read from. Empty: folder sources are turned off.
INGEST_FOLDER_ROOT=
# headless-rag phrase cache archive (.edn.gz) and its identity file. Empty: no phrase cache.
PHRASE_CACHE_ARCHIVE=
# PHRASE_CACHE_IDENTITY=

# --- Traces (OTLP over HTTP) ---------------------------------------------------------------------
# Empty: no traces exported. Langfuse: https://<host>/api/public/otel plus the two keys.
TRACES_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# true sends prompts and answers with the traces. Default false.
TRACES_CONTENT=false
# Label on every trace, for example local or test.
TRACES_ENVIRONMENT=
# norway, eu or global (default): where the trace store is, shown in the console.
TRACES_RESIDENCY=

# --- Login and access --------------------------------------------------------------------------
# REQUIRED (or Maskinporten below) unless GENAI_DEV_MODE=true. Empty in dev mode: the API runs a mock Ansattporten
# at /mock/ansattporten with the test persons in apps/api/config/local/identity.yaml. JWKS defaults to <issuer>/jwks.json.
ANSATTPORTEN_ISSUER=
# ANSATTPORTEN_JWKS_URI=
# Only in dev mode with the mock login: API keys registered at startup. DEV_SERVICE_API_KEY is bound to one service,
# DEV_SERVICE_API_KEY_SERVICE (default kunnskapsassistenten).
DEV_API_KEY=
DEV_SERVICE_API_KEY=
# DEV_SERVICE_API_KEY_SERVICE=
# Comma separated token subjects that get the operator role, on top of the operators in identity.yaml.
OPERATOR_SUBJECTS=
# Token audience and Altinn resource. Defaults: digdir:genai and urn:altinn:resource:digdir-genai-platform.
# API_AUDIENCE=
# ALTINN_RESOURCE=

# Maskinporten tokens from agency systems. Empty: no Maskinporten clients are accepted.
MASKINPORTEN_ISSUER=
MASKINPORTEN_JWKS_URI=
# Scopes every incoming Maskinporten token must carry, space or comma separated.
MASKINPORTEN_REQUIRED_SCOPE=

# Real Altinn PDP. REQUIRED unless GENAI_DEV_MODE=true. Empty in dev mode: the mock PDP answers from identity.yaml.
# Set it and ALTINN_SUBSCRIPTION_KEY, ALTINN_PDP_MASKINPORTEN_CLIENT_ID, ALTINN_PDP_MASKINPORTEN_KEY
# and MASKINPORTEN_ISSUER are REQUIRED, or the API refuses to start.
ALTINN_PDP_URL=
ALTINN_SUBSCRIPTION_KEY=
ALTINN_PDP_MASKINPORTEN_CLIENT_ID=
# Private JWK (JSON) of the Maskinporten client that asks the PDP.
ALTINN_PDP_MASKINPORTEN_KEY=
# Defaults: altinn:authorization/authorize and <MASKINPORTEN_ISSUER>token.
# ALTINN_PDP_MASKINPORTEN_SCOPE=
MASKINPORTEN_TOKEN_URL=

# Organisation names in the console from https://data.brreg.no/enhetsregisteret/api/enheter.
# Empty: the console only finds registered tenants.
ENHETSREGISTERET_URL=

# --- Server ------------------------------------------------------------------------------------
# Defaults: 8080, dev and apps/api/config/local.
# PORT=
# APP_VERSION=
# CONFIG_DIR=
# true also publishes the parity services from apps/parity/config/services.
SEED_PARITY_SERVICES=
# Local debugging only: write task error messages to the API log. They can contain what users wrote.
LOG_FAILURE_MESSAGES=

# --- Worker (apps/worker) ----------------------------------------------------------------------
# Defaults: 991825827 and packages/jobs/examples.
# PLATFORM_TENANT=
# WORKER_SERVICES_DIR=

# --- Price import (scripts/import-azure-prices.ts) -------------------------------------------------
# A running API to discover model ids from, a key for it, and extra comma separated model ids.
GENAI_API_URL=
GENAI_API_KEY=
GENAI_MODEL_IDS=

# --- Browser apps (Vite) -------------------------------------------------------------------------
# Not read from this file: set them in the shell or in apps/<app>/.env.local.
# In Azure the apps read these at start from /config.js, without the VITE_ prefix (infra/README.md).
# VITE_API=mock                  run portal, console or workspace against in-browser mock data
# VITE_ANSATTPORTEN_ISSUER=      portal and workspace login issuer (default the mock on :8080)
# VITE_OIDC_ISSUER= VITE_OIDC_CLIENT_ID= VITE_OIDC_TOKEN_ENDPOINT=   console login
# VITE_API_AUDIENCE= VITE_ALTINN_RESOURCE=                           console token request
# VITE_PUBLIC_API_BASE=          API address shown in code samples (default http://localhost:8080)
# VITE_PORTAL_URL=               portal link from the workspace (default http://localhost:5173)
# VITE_ENVIRONMENT=              environment label in the console header

# --- Live contract tests (packages/client/src/live-contract.test.ts) -------------------------------
# Skipped unless GENAI_CONTRACT_URL and GENAI_CONTRACT_SERVICE are set. They call a running API and cost model money.
# GENAI_CONTRACT_URL=http://localhost:8080
# GENAI_CONTRACT_KEY=
# GENAI_CONTRACT_SERVICE=
# GENAI_CONTRACT_QUESTION=
# GENAI_CONTRACT_DATASET=
# GENAI_CONTRACT_FILTER=
# GENAI_CONTRACT_FEEDBACK=
# GENAI_CONTRACT_USER=

# apps/parity has its own settings: .env.parity.example.
