# Copy to .env.parity (gitignored). Read only by apps/parity.

# headless-rag running locally (bb dev). Create a key in its admin console under API keys.
PARITY_OLD_URL=http://127.0.0.1:8099
PARITY_OLD_API_KEY=

# The new platform running locally (npm run dev -w @genai/api).
PARITY_NEW_URL=http://127.0.0.1:8080
PARITY_NEW_API_KEY=

# Only for recording LLM calls once, so both systems can be replayed without a live model.
PARITY_LLM_UPSTREAM_URL=
PARITY_LLM_UPSTREAM_KEY=
# api-key (Azure style, default) or bearer
PARITY_LLM_UPSTREAM_AUTH=api-key

# Only for the quality sweep. Use a different model family than the one being judged.
# openai-chat (default) or anthropic-messages
PARITY_JUDGE_PROTOCOL=openai-chat
PARITY_JUDGE_URL=
PARITY_JUDGE_KEY=
PARITY_JUDGE_MODEL=
