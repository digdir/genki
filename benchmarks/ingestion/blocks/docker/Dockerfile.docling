# Docling 2.146.0 with the versions the page tests ran (opb side docling), for CUDA or CPU hosts.
# PyPI's Linux x86_64 torch wheels carry their own CUDA runtime; the host needs only the NVIDIA driver.
FROM python:3.13-slim
# tesseract-ocr-nor: for docling-tess only; Docling's automatic OCR choice never picks Tesseract, so docling and
# docling-no are unchanged by it.
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 tesseract-ocr tesseract-ocr-nor \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir \
    docling==2.146.0 docling-core==2.105.0 docling-ibm-models==4.0.4 \
    rapidocr==3.10.0 easyocr==1.7.2 torch==2.15.0 torchvision==0.29.2
# docling-tess-best: Tesseract's more accurate Norwegian model, pinned to the tessdata_best 4.1.0 tag
RUN mkdir -p /usr/share/tessdata-best && python -c "import urllib.request; urllib.request.urlretrieve('https://github.com/tesseract-ocr/tessdata_best/raw/4.1.0/nor.traineddata', '/usr/share/tessdata-best/nor.traineddata')"
# The folder also needs what Docling uses from the standard one: osd.traineddata (orientation detection, run first)
# and configs/ (Docling asks for TSV output through configs/tsv). Without them OCR fails per region and Docling
# carries on with no text and exit code 0.
RUN TD="$(tesseract --list-langs 2>&1 | head -1 | sed -E 's/.*"(.*)".*/\1/')" \
    && cp -L "$TD/osd.traineddata" /usr/share/tessdata-best/ && cp -RL "$TD/configs" /usr/share/tessdata-best/
COPY documents.json /app/documents.json
COPY convert/ /app/convert/
WORKDIR /app/convert
ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "convert_docling.py"]
