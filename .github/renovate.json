{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    "abandonments:recommended",
    ":configMigration",
    ":semanticCommitsDisabled"
  ],
  "schedule": ["* * * * 1"],
  "timezone": "Europe/Oslo",
  "rangeStrategy": "bump",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "branchConcurrentLimit": 20,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "benchmarks/**"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": { "enabled": true, "labels": ["security"] },
  "lockFileMaintenance": { "enabled": true, "schedule": ["* * * * 1"] },
  "packageRules": [
    {
      "description": "Every version update waits three days, so a compromised release is usually pulled before it lands",
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Patch, minor, digest, pin and lock file updates merge themselves through the merge queue once every check is green",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest", "lockFileMaintenance"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Majors wait for a tick on the Dependency Dashboard and get a pull request each",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major"
    },
    { "matchPackageNames": ["typescript"], "rangeStrategy": "replace" },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "groupName": "docker digests"
    },
    {
      "description": "Node stays on 24 in mise, engines and the Docker image, so dev, CI and production move together",
      "matchDatasources": ["docker", "node-version"],
      "matchPackageNames": ["node"],
      "allowedVersions": "/^24\\./",
      "groupName": "node 24"
    },
    {
      "description": "The Docling image's packages are hashed for Python 3.13",
      "matchFileNames": ["docker/docling/Dockerfile"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.14"
    },
    {
      "description": "The Docling image's requirements are one frozen set, remade together with a new cut-off (see its header)",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["docker/docling/**"],
      "groupName": "docling server python packages",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "GitHub Actions run with the deploy credentials, so a person reviews every update",
      "matchManagers": ["github-actions"],
      "automerge": false
    },
    {
      "matchManagers": ["bicep"],
      "groupName": "bicep api versions",
      "minimumReleaseAge": null
    },
    {
      "description": "The container apps environment needs the preview API for appInsightsConfiguration and openTelemetryConfiguration (#359)",
      "matchManagers": ["bicep"],
      "matchPackageNames": ["Microsoft.App/**"],
      "enabled": false
    },
    {
      "description": "The local Langfuse moves with production's, by hand",
      "matchFileNames": ["compose.langfuse.yaml"],
      "enabled": false
    }
  ]
}
