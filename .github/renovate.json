{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":semanticCommitsDisabled"
  ],
  "schedule": ["before 7am on monday"],
  "timezone": "Europe/Oslo",
  "rangeStrategy": "bump",
  "prConcurrentLimit": 5,
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 7am on monday"] },
  "vulnerabilityAlerts": { "enabled": true, "schedule": ["at any time"] },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "npm minor and patch"
    },
    { "matchPackageNames": ["typescript"], "rangeStrategy": "replace" },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "matchManagers": ["bicep"],
      "groupName": "bicep api versions"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node"],
      "allowedVersions": "/^24\\./"
    },
    {
      "description": "The local Langfuse moves with production's, by hand",
      "matchFileNames": ["compose.langfuse.yaml"],
      "enabled": false
    },
    {
      "description": "Patch and minor updates merge themselves once every check is green; majors and 0.x stay manual",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Pins, digests and lock file maintenance merge themselves once every check is green",
      "matchUpdateTypes": ["pin", "pinDigest", "digest", "lockFileMaintenance"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "GitHub Actions run with the deploy credentials, so a person reviews every update",
      "matchManagers": ["github-actions"],
      "automerge": false
    }
  ]
}
