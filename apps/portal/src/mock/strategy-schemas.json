{
  "list": [
    {
      "kind": "Service",
      "version": "v1",
      "apiVersion": "genai/v1",
      "title": {
        "nb": "Tjeneste",
        "en": "Service"
      },
      "href": "/schemas/Service%40v1",
      "uses": [
        {
          "kind": "Strategy.single-call",
          "version": "1",
          "at": "spec.strategy.config",
          "when": {
            "field": "spec.strategy.id",
            "equals": "single-call"
          },
          "title": {
            "nb": "Ett steg",
            "en": "One step"
          },
          "href": "/schemas/Strategy.single-call%401"
        },
        {
          "kind": "Strategy.agent-loop",
          "version": "1",
          "at": "spec.strategy.config",
          "when": {
            "field": "spec.strategy.id",
            "equals": "agent-loop"
          },
          "title": {
            "nb": "Agent (søker selv)",
            "en": "Agent (searches by itself)"
          },
          "href": "/schemas/Strategy.agent-loop%401"
        },
        {
          "kind": "Strategy.rag-single-shot",
          "version": "1",
          "at": "spec.strategy.config",
          "when": {
            "field": "spec.strategy.id",
            "equals": "rag-single-shot"
          },
          "title": {
            "nb": "Ett søk og ett svar",
            "en": "One search and one answer"
          },
          "href": "/schemas/Strategy.rag-single-shot%401"
        },
        {
          "kind": "Strategy.step-flow",
          "version": "1",
          "at": "spec.strategy.config",
          "when": {
            "field": "spec.strategy.id",
            "equals": "step-flow"
          },
          "title": {
            "nb": "Fast stegflyt",
            "en": "Fixed step flow"
          },
          "href": "/schemas/Strategy.step-flow%401"
        },
        {
          "kind": "Strategy.remote-agent",
          "version": "1",
          "at": "spec.strategy.config",
          "when": {
            "field": "spec.strategy.id",
            "equals": "remote-agent"
          },
          "title": {
            "nb": "Egen motor",
            "en": "Own engine"
          },
          "href": "/schemas/Strategy.remote-agent%401"
        },
        {
          "kind": "Strategy.builder-assistant",
          "version": "1",
          "at": "spec.strategy.config",
          "when": {
            "field": "spec.strategy.id",
            "equals": "builder-assistant"
          },
          "title": {
            "nb": "Byggeassistenten",
            "en": "The builder assistant"
          },
          "href": "/schemas/Strategy.builder-assistant%401"
        },
        {
          "kind": "Strategy.optimiser",
          "version": "1",
          "at": "spec.strategy.config",
          "when": {
            "field": "spec.strategy.id",
            "equals": "optimiser"
          },
          "title": {
            "nb": "Forbedringsassistenten",
            "en": "The improvement assistant"
          },
          "href": "/schemas/Strategy.optimiser%401"
        }
      ]
    }
  ],
  "schemas": {
    "/schemas/Strategy.single-call%401": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "instructions": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": ["nb", "nn", "en"]
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              }
            }
          ],
          "x-label": {
            "nb": "Instruksjoner",
            "en": "Instructions"
          },
          "x-help": {
            "nb": "Én tekst for alle språk, eller én per språk.",
            "en": "One text for every language, or one per language."
          },
          "x-widget": "prompt",
          "x-right": "manage-services"
        },
        "languageInstructions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": ["nb", "nn", "en"]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "x-label": {
            "nb": "Tillegg per språk",
            "en": "Additions per language"
          },
          "x-help": {
            "nb": "Legges til instruksjonene når svaret skal være på dette språket.",
            "en": "Added to the instructions when the answer is in this language."
          },
          "x-widget": "map",
          "x-right": "manage-services"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "x-label": {
            "nb": "Eksempler",
            "en": "Examples"
          },
          "x-advanced": true,
          "x-widget": "list",
          "x-right": "manage-services"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "x-label": {
            "nb": "Temperatur",
            "en": "Temperature"
          },
          "x-help": {
            "nb": "Lav gir like svar, høy gir mer variasjon.",
            "en": "Low gives similar answers, high gives more variety."
          },
          "x-widget": "number",
          "x-right": "manage-services"
        },
        "maxTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "x-label": {
            "nb": "Lengste svar (tokens)",
            "en": "Longest answer (tokens)"
          },
          "x-widget": "number",
          "x-right": "manage-services"
        },
        "reasoning": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "x-label": {
            "nb": "Hvor grundig modellen resonnerer",
            "en": "How thoroughly the model reasons"
          },
          "x-enumLabels": {
            "low": {
              "nb": "Lite",
              "en": "Little"
            },
            "medium": {
              "nb": "Middels",
              "en": "Medium"
            },
            "high": {
              "nb": "Mye",
              "en": "A lot"
            }
          },
          "x-widget": "select",
          "x-right": "manage-services"
        }
      },
      "required": ["instructions"],
      "additionalProperties": false,
      "x-right": "manage-services",
      "$id": "/schemas/Strategy.single-call@1",
      "x-label": {
        "nb": "Ett steg",
        "en": "One step"
      }
    },
