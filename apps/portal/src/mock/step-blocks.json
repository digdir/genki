  {
    "ref": "evidence-gate@1",
    "name": "evidence-gate",
    "version": "1",
    "description": "Decide before any model call whether the evidence is thick enough for an overview",
    "title": {
      "nb": "Sjekk om grunnlaget holder",
      "en": "Check whether the basis holds"
    },
    "summary": {
      "nb": "Avgjør om det er nok gode kilder til å svare.",
      "en": "Decides whether there are enough good sources to answer."
    },
    "input": {
      "type": "object",
      "properties": {
        "chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "chunkId": {
                "type": "string"
              }
            },
            "required": ["chunkId"],
            "additionalProperties": {}
          }
        },
        "contextDocs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": ["content", "source"],
            "additionalProperties": {}
          }
        }
      },
      "required": ["chunks", "contextDocs"],
      "additionalProperties": {}
    },
    "params": {
      "type": "object",
      "properties": {
        "minContextDocs": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-label": {
            "nb": "Færrest dokumenter i grunnlaget",
            "en": "Fewest documents in the basis"
          },
          "x-widget": "number"
        },
        "minSupportingChunks": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-label": {
            "nb": "Færrest tekstbiter som støtter svaret",
            "en": "Fewest text chunks that support the answer"
          },
          "x-widget": "number"
        },
        "supportScoreRatio": {
          "default": 0.6,
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "x-label": {
            "nb": "Andel av beste poeng som regnes som støtte",
            "en": "Share of the best score that counts as support"
          },
          "x-widget": "number"
        },
        "minDistinctDocuments": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-label": {
            "nb": "Færrest ulike dokumenter",
            "en": "Fewest different documents"
          },
          "x-widget": "number"
        },
        "minTopScore": {
          "type": "number",
          "x-label": {
            "nb": "Laveste poeng for beste treff",
            "en": "Lowest score for the best result"
          },
          "x-widget": "number"
        }
      },
      "additionalProperties": false
    },
