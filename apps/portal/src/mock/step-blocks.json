          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "x-label": {
            "nb": "Tjeneste som søker selv i steget",
            "en": "Service that searches by itself in the step"
          },
          "x-widget": "map"
        },
        "retrieval": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "x-label": {
            "nb": "Overstyring av søket",
            "en": "Search overrides"
          },
          "x-widget": "code",
          "x-advanced": true
