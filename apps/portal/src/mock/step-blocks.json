    "title": {
      "nb": "La modellen søke selv",
      "en": "Let the model search by itself"
    },
    "summary": {
      "nb": "Lar modellen søke, lese og svare selv, som ett steg i flyten.",
      "en": "Lets the model search, read and answer by itself, as one step in the flow."
