    "params": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "x-label": {
            "nb": "Systemledetekst",
            "en": "System prompt"
          },
          "x-widget": "prompt"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "x-label": {
            "nb": "Temperatur",
            "en": "Temperature"
          },
          "x-widget": "number"
        },
        "maxTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "x-label": {
            "nb": "Lengste svar (tokens)",
            "en": "Longest answer (tokens)"
          },
          "x-widget": "number"
        },
        "name": {
          "default": "extraction",
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "x-label": {
            "nb": "Navn",
            "en": "Name"
          },
          "x-widget": "text"
        },
        "schema": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "x-label": {
            "nb": "Skjema for det som hentes ut",
            "en": "Schema for what is extracted"
          },
          "x-widget": "code"
        },
        "maxContextLength": {
          "default": 24000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "x-label": {
            "nb": "Lengste grunnlag (tegn)",
            "en": "Longest basis (characters)"
          },
          "x-widget": "number"
        },
        "maxWindows": {
          "default": 6,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 40,
          "x-label": {
            "nb": "Flest tekstvinduer",
            "en": "Most text windows"
          },
          "x-widget": "number"
        },
        "reasoning": {
          "default": "low",
          "type": "string",
          "enum": ["low", "medium", "high"],
          "x-label": {
            "nb": "Hvor grundig modellen resonnerer",
