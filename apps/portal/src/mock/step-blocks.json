          "x-enumLabels": {
            "low": {
              "nb": "Lite",
              "en": "Little"
            },
            "medium": {
              "nb": "Middels",
              "en": "Medium"
            },
            "high": {
              "nb": "Mye",
              "en": "A lot"
            }
          },
          "x-widget": "select"
