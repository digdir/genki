{
  "name": "genki",
  "repository": "github:digdir/genki",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node scripts/setup.ts && node scripts/dev-all.ts",
    "setup": "node scripts/setup.ts",
    "knowledge:setup": "tsx --conditions=source scripts/knowledge-server-setup.ts",
    "knowledge:seed": "tsx --conditions=source scripts/knowledge-seed.ts",
    "dev": "npm run dev --workspace apps/api",
    "dev:all": "node scripts/dev-all.ts",
    "dev:model": "node scripts/local-model.ts",
    "langfuse": "docker compose -p langfuse-genki -f compose.langfuse.yaml up -d --wait",
    "langfuse:seed": "node scripts/langfuse-seed.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "eslint .",
    "boundaries": "depcruise packages apps --config .dependency-cruiser.cjs",
    "size": "node scripts/size-budget.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run boundaries && npm run size && npm test",
    "parity": "npm run parity --workspace apps/parity --",
    "atlas:build": "tsx --conditions=source scripts/build-atlas.ts",
    "atlas:test": "vitest run --root scripts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
